# syntax=docker/dockerfile:1
#==============================================================================
# Databricks Runtime 17.3 LTS (R flavor) + OHDSI HADES 1.20.0
#
# Installs HADES on top of the Databricks R cluster runtime so the image runs
# as Databricks cluster compute. Uses the base image's own R installation
# (databricksruntime/rbase, not /standard, which is Python/Spark-only and
# has no R at all).
#
# HADES is restored from a pinned renv.lock (generated against
# databricksruntime/rbase's R 4.6.1) rather than a live
# remotes::install_github() call. HADES pulls in 18 packages from
# github.com/ohdsi; resolving their dependency graph live means renv/remotes
# recursively querying the GitHub API for every dependency-of-a-dependency,
# which burns through the unauthenticated 60-requests/hour limit before the
# install finishes. Restoring a pre-resolved lockfile only needs one API call
# per GitHub package (18 total), comfortably within that limit.
#
# renv's install phase has one deadline for the whole restore
# (RENV_INSTALL_TIMEOUT / options(renv.install.timeout), 3600s by default).
# ~210 packages compiled from source (no binary package mirror is used here)
# comfortably overruns that, so the timeout below is raised well past a full
# from-source restore.
#
# renv's default transactional install stages every package in a temporary
# library and only migrates them into the real project library once the
# whole restore succeeds. A package installed mid-restore that runs its own
# dependency check (e.g. OhdsiSharing checking for rJava/ParallelLogger)
# looks at the not-yet-populated project library and fails even though its
# dependency already installed successfully. transactional = FALSE installs
# packages directly into the project library as they finish instead.
#
# Apple Silicon build (from the repository root, since the LABEL/tag scheme
# matches every other tool in this repo):
#
#   docker buildx build \
#     --platform linux/amd64 \
#     -t getwilds/hades:1.20.0 \
#     -f hades/Dockerfile_1.20.0 \
#     --load \
#     .
#==============================================================================

FROM databricksruntime/rbase:17.3-LTS

# Adding labels for the GitHub Container Registry
LABEL org.opencontainers.image.title="hades"
LABEL org.opencontainers.image.description="Docker image for OHDSI HADES in Fred Hutch OCDO's WILDS"
LABEL org.opencontainers.image.version="1.20.0"
LABEL org.opencontainers.image.authors="wilds@fredhutch.org"
LABEL org.opencontainers.image.url=https://ocdo.fredhutch.org/
LABEL org.opencontainers.image.documentation=https://getwilds.org/
LABEL org.opencontainers.image.source=https://github.com/getwilds/wilds-docker-library
LABEL org.opencontainers.image.licenses=MIT

USER root

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

#------------------------------------------------------------------------------
# System dependencies for compiling HADES's CRAN and OHDSI packages from
# source. Compiling this many R packages (rather than installing from a
# binary package mirror) needs a broad set of -dev headers; this list is
# proven against the full HADES 1.20.0 dependency tree.
#------------------------------------------------------------------------------

RUN apt-get update \
  && PKGS="ca-certificates curl wget git build-essential gcc g++ gfortran \
  make cmake perl xz-utils bzip2 pkg-config unixodbc unixodbc-dev odbcinst \
  libcurl4-openssl-dev libssl-dev libxml2-dev libgit2-dev libicu-dev \
  libbz2-dev liblzma-dev zlib1g-dev libreadline-dev libncurses-dev \
  libncurses5-dev libncursesw5-dev libtinfo-dev libpcre2-dev libx11-dev \
  libxt-dev libpng-dev libjpeg-dev libtiff-dev libcairo2-dev \
  libfontconfig1-dev libfreetype6-dev libharfbuzz-dev libfribidi-dev \
  libzstd-dev libuv1-dev" \
  && apt-get install -y --no-install-recommends ${PKGS} \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Set R library paths to avoid host contamination in Apptainer
ENV R_LIBS_USER=/usr/local/lib/R/site-library
ENV R_LIBS=/usr/local/lib/R/site-library:/usr/lib/R/site-library:/usr/lib/R/library

#------------------------------------------------------------------------------
# Point R at the base image's Java (rJava's configure otherwise looks for
# /usr/lib/jvm/default-java, which this image does not symlink).
#------------------------------------------------------------------------------

ENV JAVA_HOME=/usr/lib/jvm/zulu17-ca-amd64

RUN R CMD javareconf

#------------------------------------------------------------------------------
# Restore HADES from the pinned lockfile (see header comment for why this
# isn't a plain remotes::install_github() call).
#------------------------------------------------------------------------------

ARG CRAN_REPO=https://cloud.r-project.org
ARG RENV_INSTALL_TIMEOUT=21600

COPY hades/renv.lock /opt/ohdsi/hades/renv.lock

RUN R -e "install.packages('renv', repos = '${CRAN_REPO}')" \
  && R -e "\
    options(renv.install.timeout = ${RENV_INSTALL_TIMEOUT}); \
    renv::restore(lockfile = '/opt/ohdsi/hades/renv.lock', repos = c(CRAN = '${CRAN_REPO}'), transactional = FALSE, prompt = FALSE)"

# Smoke test: confirm HADES loads
RUN R -e "library(Hades); packageVersion('Hades')"

WORKDIR /
